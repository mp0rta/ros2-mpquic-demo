{
  mode: "peer",
  listen: { endpoints: ["quic/0.0.0.0:7447"] },
  scouting: { multicast: { enabled: false } },
  transport: {
    link: {
      tls: {
        listen_certificate: "certs/server.pem",
        listen_private_key: "certs/server-key.pem",
      },
      quic: { multipath: { enabled: true, max_concurrent_paths: 4 } },
    },
  },
}
